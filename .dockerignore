# Keep the build context small. Anything not on this allow-by-omission list
# is excluded; mirror the COPY statements in Dockerfile when changing.

# Local development artefacts
.venv
venv
__pycache__
*.pyc
.pytest_cache
.mypy_cache
.coverage
.chromadb

# Data / logs / snapshots — must NOT leak into the image
agent_platform.db
agent_platform.db-*
incidents.db
incidents/
logs/
summaries/
.preference_pairs.jsonl

# Editor / OS junk
.git
.gitignore
.github
.idea
.vscode
.DS_Store
*.swp

# Build output (regenerated inside the image)
frontend/node_modules
frontend/dist
node_modules

# Tests + dev-only docs (image doesn't need them)
# The CONSTRAINTS.md/AGENTS.md exception this used to need is gone —
# targets/target-app/ no longer lives in this repo or gets copied into the
# image at all (fetched from S3 at container startup instead, see
# docs/PLAN_TARGET_HARNESS_SPLIT.md).
tests
plans
memory
docs
*.md

# Secrets — defensive; SSM Parameter Store is the prod source
.env
.env.*
*.pem
*.key
