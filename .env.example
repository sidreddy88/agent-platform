ANTHROPIC_API_KEY=sk-ant-...
DEBUG=false

# Required for the incident-remediation pipeline to open real PRs
GITHUB_TOKEN=
FIX_TARGET_REPO=your-org/your-repo

# Used by the RAG service (embeddings) — optional, RAG features degrade
# gracefully without it
OPENAI_API_KEY=
CODEBASE_PATH=

# AWS — leave blank to use local credentials (~/.aws/credentials / env vars)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Langfuse tracing — leave blank to disable tracing (silently, see docs/ARCHITECTURE.md)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Slack alerting — leave blank to fall back to console logging
SLACK_WEBHOOK_URL=

# Required — gates /debug/* and /injection/trigger (see app/api/auth.py for
# why). Unlike the other tokens here, leaving this blank does NOT disable
# auth — it fails closed (503) instead, so these routes are simply unusable
# until you set a real value. Any random secret string works for local dev.
ADMIN_API_TOKEN=

# Optional — same shared-secret pattern for the CloudWatch SNS webhook.
# Leave blank to skip token auth on that one route (not recommended in prod).
CLOUDWATCH_WEBHOOK_TOKEN=
